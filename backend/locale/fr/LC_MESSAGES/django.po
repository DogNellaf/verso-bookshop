msgid "Only pending orders can be paid."
msgstr "Seules les commandes en attente peuvent être payées."

msgid "This payment is already finished."
msgstr "Ce paiement est déjà terminé."

msgid "The card number is not valid."
msgstr "Le numéro de carte n'est pas valide."

msgid "Enter the expiry date as MM/YY."
msgstr "Indiquez la date d'expiration au format MM/AA."

msgid "The card has expired."
msgstr "La carte a expiré."

msgid "Enter the 3 or 4 digit security code."
msgstr "Saisissez le code de sécurité à 3 ou 4 chiffres."

msgid "Your card was declined."
msgstr "Votre carte a été refusée."

msgid "Your card has insufficient funds."
msgstr "Le solde de votre carte est insuffisant."

#, python-format
msgid "“%(title)s” is out of stock."
msgstr "« %(title)s » est en rupture de stock."

#, python-format
msgid "Only %(count)d copy of “%(title)s” is in stock."
msgid_plural "Only %(count)d copies of “%(title)s” are in stock."
msgstr[0] "Il ne reste que %(count)d exemplaire de « %(title)s »."
msgstr[1] "Il ne reste que %(count)d exemplaires de « %(title)s »."

msgid "Your cart is empty."
msgstr "Votre panier est vide."

msgid "Not enough stock."
msgstr "Stock insuffisant."

msgid "Orders that have been shipped can no longer be cancelled."
msgstr "Une commande expédiée ne peut plus être annulée."
