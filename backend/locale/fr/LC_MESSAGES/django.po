#: main/views.py:208
msgid "Your cart is empty."
msgstr "Votre panier est vide."

#: main/views.py:222
msgid "Not enough stock."
msgstr "Stock insuffisant."

#: main/views.py:284
msgid "Only pending orders can be cancelled."
msgstr "Seules les commandes en attente peuvent être annulées."
