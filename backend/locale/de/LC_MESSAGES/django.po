msgid "Only pending orders can be paid."
msgstr "Nur ausstehende Bestellungen können bezahlt werden."

msgid "This payment is already finished."
msgstr "Diese Zahlung ist bereits abgeschlossen."

msgid "The card number is not valid."
msgstr "Die Kartennummer ist ungültig."

msgid "Enter the expiry date as MM/YY."
msgstr "Geben Sie das Ablaufdatum als MM/JJ ein."

msgid "The card has expired."
msgstr "Die Karte ist abgelaufen."

msgid "Enter the 3 or 4 digit security code."
msgstr "Geben Sie den 3- oder 4-stelligen Sicherheitscode ein."

msgid "Your card was declined."
msgstr "Ihre Karte wurde abgelehnt."

msgid "Your card has insufficient funds."
msgstr "Ihre Karte ist nicht ausreichend gedeckt."

#, python-format
msgid "“%(title)s” is out of stock."
msgstr "„%(title)s“ ist nicht vorrätig."

#, python-format
msgid "Only %(count)d copy of “%(title)s” is in stock."
msgid_plural "Only %(count)d copies of “%(title)s” are in stock."
msgstr[0] "Von „%(title)s“ ist nur noch %(count)d Exemplar vorrätig."
msgstr[1] "Von „%(title)s“ sind nur noch %(count)d Exemplare vorrätig."

msgid "Your cart is empty."
msgstr "Ihr Warenkorb ist leer."

msgid "Not enough stock."
msgstr "Nicht genügend Bestand."

msgid "Orders that have been shipped can no longer be cancelled."
msgstr "Versandte Bestellungen können nicht mehr storniert werden."
