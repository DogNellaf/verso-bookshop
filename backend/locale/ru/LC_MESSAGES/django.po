#: main/views.py:30
#, python-format
msgid "“%(title)s” is out of stock."
msgstr "«%(title)s» нет в наличии."

#: main/views.py:32
#, python-format
msgid "Only %(count)d copy of “%(title)s” is in stock."
msgid_plural "Only %(count)d copies of “%(title)s” are in stock."
msgstr[0] "Осталось только %(count)d экземпляр «%(title)s»."
msgstr[1] "Осталось только %(count)d экземпляра «%(title)s»."
msgstr[2] "Осталось только %(count)d экземпляров «%(title)s»."
msgstr[3] "Осталось только %(count)d экземпляра «%(title)s»."

#: main/views.py:208
msgid "Your cart is empty."
msgstr "Ваша корзина пуста."

#: main/views.py:222
msgid "Not enough stock."
msgstr "Недостаточно товара на складе."

#: main/views.py:284
msgid "Only pending orders can be cancelled."
msgstr "Отменить можно только заказ в статусе «Ожидает»."
