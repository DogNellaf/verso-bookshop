msgid "Only pending orders can be paid."
msgstr "Оплатить можно только заказ в статусе «Ожидает»."

msgid "This payment is already finished."
msgstr "Этот платёж уже завершён."

msgid "The card number is not valid."
msgstr "Неверный номер карты."

msgid "Enter the expiry date as MM/YY."
msgstr "Укажите срок действия в формате ММ/ГГ."

msgid "The card has expired."
msgstr "Срок действия карты истёк."

msgid "Enter the 3 or 4 digit security code."
msgstr "Введите код безопасности из 3 или 4 цифр."

msgid "Your card was declined."
msgstr "Банк отклонил платёж по карте."

msgid "Your card has insufficient funds."
msgstr "На карте недостаточно средств."

#, python-format
msgid "“%(title)s” is out of stock."
msgstr "«%(title)s» нет в наличии."

#, python-format
msgid "Only %(count)d copy of “%(title)s” is in stock."
msgid_plural "Only %(count)d copies of “%(title)s” are in stock."
msgstr[0] "Осталось только %(count)d экземпляр «%(title)s»."
msgstr[1] "Осталось только %(count)d экземпляра «%(title)s»."
msgstr[2] "Осталось только %(count)d экземпляров «%(title)s»."
msgstr[3] "Осталось только %(count)d экземпляра «%(title)s»."

msgid "Your cart is empty."
msgstr "Ваша корзина пуста."

msgid "Not enough stock."
msgstr "Недостаточно товара на складе."

msgid "Only pending orders can be cancelled."
msgstr "Отменить можно только заказ в статусе «Ожидает»."
