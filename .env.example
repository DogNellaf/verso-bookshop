# Copy to .env and adjust for your environment: cp .env.example .env
# docker-compose reads these automatically.

# Django
DEBUG=False
SECRET_KEY=please-change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Postgres
POSTGRES_DB=bookshop
POSTGRES_USER=bookshop
POSTGRES_PASSWORD=bookshop

# Seed demo data (books, covers, demo user, orders) on first backend boot.
SEED_ON_START=1

# Optional admin account for /admin/ (created on boot if both are set).
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Set to True when served over HTTPS (secure cookies, HSTS, SSL redirect).
# HTTPS=False

# Public address of the site, used for links back from the payment page.
SITE_URL=http://localhost:8080

# Payments. "demo" accepts test cards (4242 4242 4242 4242), "stripe" uses
# Stripe Checkout. For Stripe, point a webhook at
# $SITE_URL/api/payments/stripe/webhook/ for the checkout.session.* events.
PAYMENT_PROVIDER=demo
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Machine translation of new books into ru, fr and de.
# DEEPL_API_KEY=...:fx
AUTO_TRANSLATE_BOOKS=True
# False keeps machine translations off the storefront until staff review them.
PUBLISH_UNREVIEWED_TRANSLATIONS=True

# Fetch exchange rates (USD, EUR, RUB) when the container starts. The
# scheduler container refreshes them every EXCHANGE_RATES_INTERVAL_HOURS.
UPDATE_RATES_ON_START=1
EXCHANGE_RATES_INTERVAL_HOURS=24

# The scheduler cancels payments left pending for longer than this.
PAYMENT_TIMEOUT_HOURS=24
# Unpaid orders are cancelled after this and their books go back to stock.
UNPAID_ORDER_TIMEOUT_HOURS=48
